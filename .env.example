# Anthropic API key for the AI assistant route handler.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: disables synthetic 5% error rate in mock-backend (use for screencasts)
# NEXT_PUBLIC_RELIABLE=1

# ─────────────────────────────────────────────────────────────────────────────
# Protokoll-Modus (optional, local-only) — makes the demo speak the REAL
# Deutschland-Stack protocols against TEST sandboxes. All flags default OFF;
# the deployed Vercel build never enables them (routes 404 → inert). Details:
# docs/specs/protokoll-modus.md · docs/specs/protocol-real-integration-plan.md
# NEVER a real Behörde: FIT-Connect uses our own [MOCK destination] Zustellpunkt,
# EUDI uses the EU reference/development trust anchors (not eIDAS, not production).
# ─────────────────────────────────────────────────────────────────────────────

# --- FIT-Connect (federal submission transport), FITKO TEST environment ---
# Bring your own free TEST client: register at
# https://portal.auth-testing.fit-connect.fitko.dev (GitHub/GitLab/openCode login).
# Provision your own destination + local keys with: node scripts/fc-provision-destination.mjs
FIT_CONNECT_LIVE=0
FIT_CONNECT_CLIENT_ID=
FIT_CONNECT_CLIENT_SECRET=
FIT_CONNECT_SUBSCRIBER_CLIENT_ID=
FIT_CONNECT_SUBSCRIBER_CLIENT_SECRET=
FIT_CONNECT_DESTINATION_ID=
FIT_CONNECT_LEIKA_KEY=urn:de:fim:leika:leistung:512431
# Private JWKs stay OUTSIDE the repo (gitignored). Point at absolute paths.
FIT_CONNECT_DECRYPTION_JWK_PATH=
FIT_CONNECT_SIGNING_JWK_PATH=

# --- EUDI OpenID4VP verifier (present a real PID over the wire) ---
# EUDI_VP_EXTERNAL_URL = public base URL the wallet can reach (e.g. your dev tunnel);
# it rotates on tunnel restart — update it when the tunnel changes.
EUDI_VP_LIVE=0
EUDI_VP_EXTERNAL_URL=
# Optional: enables the x5c-signed request mode (self-signed DEMO verifier cert —
# sandbox, not eIDAS/production). Unsigned mode needs no cert. Generate the key
# with: node scripts/eudi-vp-provision-cert.mjs  (writes to .secrets/, gitignored)
# then point this at the absolute path it prints.
EUDI_VP_SIGNING_JWK_PATH=
